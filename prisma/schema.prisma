generator client {
  provider = "prisma-client"
  output   = "../generated/prisma/client"
}

datasource db {
  provider = "postgresql"
}

model StreamPost {
  id           String       @id @default(cuid())
  title        String
  content      String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  encryptLevel EncryptLevel @default(PUBLIC)
}

enum EncryptLevel {
  PUBLIC
  SEMIPUBLIC
  PRIVATE
}
